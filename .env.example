NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SMTP Nodemailer configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="VikaTech" <your-email@gmail.com>

# Server-only key used by the protected admin API. Never expose this as NEXT_PUBLIC_...
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=use-a-long-random-value-in-production
PROVISIONING_ENCRYPTION_KEY=generate-a-random-encryption-key

# ESP32 WSS gateway provisioning. The discovery settings are public; the
# shared DEVICE_WS_TOKEN from custom_mqtt_server remains secret. Do not put Mosquitto's
# MQTT_USERNAME/MQTT_PASSWORD or MQTT_INGEST_SECRET here.
ESP32_DISCOVERY_SUPABASE_URL=https://your-discovery-project.supabase.co
ESP32_DISCOVERY_ANON_KEY=your-discovery-project-anon-key
ESP32_DEVICE_WS_TOKEN=use-the-custom-mqtt-server-DEVICE_WS_TOKEN

# n8n webhook for the sales pre-order pipeline
# After importing n8n_workflow.json into n8n, activate it and paste the webhook URL here, e.g.:
# NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-host.example.com/webhook/ew-order
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-host.example.com/webhook/ew-order
NEXT_PUBLIC_VOICE_AGENT_ENABLED=false
# OpenRouter Configuration for AI Voice Commands
# Optional: local development defaults to enabled; set this to true to enable
# voice on a deployed site, or false to disable it as an admin-controlled flag.
# NEXT_PUBLIC_VOICE_AGENT_ENABLED=false
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
SARVAM_API_KEY=your-sarvam-api-key

# Web Push (generate once with: npx web-push generate-vapid-keys)
# The public key is safe to expose; the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Closed-app notifications are driven by an external 1-minute cron ping:
# GET https://your-domain/api/cron/notifications
# Header: Authorization: Bearer <CRON_SECRET>
#
# In development (npm run dev) a local in-process 1-minute cron runs
# automatically while the server stays open. For a local production build
# (npm run start) set ENABLE_LOCAL_NOTIFICATION_CRON=true to enable it.
ENABLE_LOCAL_NOTIFICATION_CRON=false
NOTIFICATION_CRON_BASE_URL=http://127.0.0.1:3000
